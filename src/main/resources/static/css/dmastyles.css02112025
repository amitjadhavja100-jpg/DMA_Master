    height: 30px;
    cursor: pointer;
}
.checkerStyle {
	background-image: url('../images/Check square.svg');
    background-repeat: no-repeat;
    height: 30px;
    cursor: pointer;
}
.gridStyle {
	background-image: url('../images/Grid.svg');
    background-repeat: no-repeat;
    height: 30px;
    cursor: pointer;
}
.dashStyle {
	background-image: url('../images/Home.svg');
    background-repeat: no-repeat;
    height: 30px;
    cursor: pointer;
}
.reportStyle {
	background-image: url('../images/List.svg');
    background-repeat: no-repeat;
    height: 30px;
    cursor: pointer;
}
.homepage {
    width:100%;
    position: fixed;
    top: 86px;
}
.homepagetd {
    vertical-align: baseline;
    padding:0px;
}
.configStyle {
	background-image: url('../images/config.png');
    background-repeat: no-repeat;
    height: 32px;
    cursor: pointer;
    background-size: contain;
}
.main-content{
   padding-top: 10px !important;
   padding-left: 30px !important;
}
.card-body {
	padding-top: 3rem !important;
    background-color:#f4f6ff;
    border: 1px solid #eaecf5;
    border-radius: 8px;
    width: 68%;
    margin-left: 16% !important;    
  }
.red-color{
	color:red;
} 

.lable-dma {
	
    font-size: 16px;
    padding: 10px;
    color: #800000;
    font-weight: bold;	
}
.btn-dma{
	 color: #ffffff; 
     background-color: #20446C; 
     border-color: #20446C;
     padding:7px 14px;
} 
.btn-dma:hover {
	 color: #ffffff !important; 
     background-color: #0f5cb1 !important; 
     border-color: #20446C;
} 
.lbl-dma{
	 color: #bc4228;
} 

.href-dma{
	 color: #0563c1;
	 cursor:pointer;
	 text-decoration:underline;
	 white-space: nowrap;
} 

.dropdown {
  float: left;
  overflow: hidden;
  background-color: #ecf9ff;
}

.dropdown .dropbtn {
  font-size: 20px;  
  border: none;
  outline: none;
  color: #000000;
  padding: 6px 16px;
  background-color: #ecf9ff;
  font-family: inherit;
  margin: 0;
  background-image: url('plugins/datatables/images/br_down.png');
  background-position: right;
  background-size: unset;
  background-repeat: no-repeat;  
}

.navbar a:hover, .dropdown:hover .dropbtn .active {
  background-color: #e7e7e7;
  color:#555;
}

.dropdown > button > .dropbtn .active{
  background-color: #e7e7e7;
  color:#555;
}

.dropdown-content {
  display: none;
  position: fixed;
  background-color: #ffffff;
  min-width: 160px;
  box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
  z-index: 1;
}

.dropdown-content a {
  float: none;
  color: black;
  padding: 12px 16px;
  text-decoration: none;
  display: block;
  text-align: left;
  cursor: pointer;
}

.dropdown-content a:hover {
  background-color: #ddd;
}

.dropdown:hover .dropdown-content {
  display: block;
}

.hsloading
{
    position:   fixed;
    z-index:    1000;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5)
                url('../images/loading.gif') 
                48% 50% 
                no-repeat;
background-size: 90px;                
}

.hsloader
{
	position: absolute;
    width: 12rem;
    height: 10rem;
    top: 66%;
    margin: 0 auto;
    left: 0;
    right: 0;
    transform: translateY(-50%);	
    font-size: 18px;
    color: #ffffff;   
  }